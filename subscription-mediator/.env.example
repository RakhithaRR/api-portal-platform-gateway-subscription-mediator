# subscription-mediator environment overrides, read by docker-compose.yaml.
#
#   cp .env.example .env
#
# then replace the placeholders. Each SM_* variable overrides the matching
# setting in configs/config.toml. .env is git-ignored; never commit a filled-in one.

SM_WEBHOOK_SECRET=<openssl rand -base64 48>
SM_GATEWAY_USERNAME=admin
SM_GATEWAY_PASSWORD=<gateway admin password>
SM_GATEWAY_BASE_URL=http://host.docker.internal:9090/api/management/v1
